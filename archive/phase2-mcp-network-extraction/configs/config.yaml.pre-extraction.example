#       transport: stdio
#       command: python
#       args: ["-m", "app.mcp.servers.mikrotik_server", "--host", "10.0.0.1"]
#       timeout_seconds: 15
#     - name: generic
#       transport: stdio
#       command: python
#       args: ["-m", "app.mcp.servers.generic_server"]
#       timeout_seconds: 10
