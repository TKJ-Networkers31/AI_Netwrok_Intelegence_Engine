# Copy to .env and adjust as needed. These override values in config/config.yaml.
# ANIE does not load .env automatically in Phase 0 - export these into your
# shell (or use a tool like `direnv`/`dotenv` CLI) before running `anie`.

# Path to an alternate config file
# ANIE_CONFIG_PATH=./config/config.yaml

# Model provider overrides
# ANIE_MODEL_PROVIDER=ollama
# ANIE_MODEL_NAME=qwen3:1.7b
# ANIE_MODEL_BASE_URL=http://localhost:11434
# ANIE_MODEL_TIMEOUT_SECONDS=60

# Logging
# ANIE_LOG_LEVEL=INFO
