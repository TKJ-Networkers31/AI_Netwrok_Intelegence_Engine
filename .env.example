# Copy to .env and adjust as needed. These override values in config/config.yaml.
# ANIE does not load .env automatically in Phase 0/1 - export these into your
# shell (or use a tool like `direnv`/`dotenv` CLI) before running `anie`.

# Path to an alternate config file
# ANIE_CONFIG_PATH=./config/config.yaml

# --- Primary provider overrides (model.primary.*) ---
# ANIE_MODEL_PROVIDER=ollama
# ANIE_MODEL_NAME=qwen3:1.7b
# ANIE_MODEL_BASE_URL=http://localhost:11434
# ANIE_MODEL_TIMEOUT_SECONDS=60

# --- Fallback provider overrides (model.fallback.*) ---
# Setting any ANIE_FALLBACK_* variable is enough to enable a fallback
# provider even if config.yaml has no `model.fallback` section at all.
# ANIE_FALLBACK_PROVIDER=nvidia
# ANIE_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
# ANIE_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# ANIE_FALLBACK_TIMEOUT_SECONDS=30
# ANIE_FALLBACK_API_KEY_ENV=NVIDIA_API_KEY

# Shared default timeout applied to primary/fallback when they don't set
# their own timeout_seconds.
# ANIE_MODEL_TIMEOUT=30

# --- NVIDIA credentials ---
# REQUIRED if the NVIDIA provider (primary or fallback) is enabled.
# This is read directly by NvidiaProvider at request time - it is never
# stored in config.yaml, never logged, and never included in error details.
# Get a key from https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...

# --- MikroTik/RouterOS credentials ---
# No longer relevant to ANIE itself: the MikroTik adapter/MCP server that
# used these was extracted to archive/phase2-mcp-network-extraction/mikrotik/
# ahead of becoming its own standalone MCP-MikroTik server project. That
# future project will define its own credential env vars (likely the same
# MIKROTIK_USERNAME/MIKROTIK_PASSWORD names) independently of ANIE.

# Logging
# ANIE_LOG_LEVEL=INFO
